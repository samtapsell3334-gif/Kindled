# Kestrel configuration. Copy to `.env` and fill in — never commit `.env`.

# --- Storage ---------------------------------------------------------
KESTREL_DB_PATH=./kestrel.db

# --- Polling -----------------------------------------------------------
POLL_INTERVAL_SECONDS=300
AUCTION_ALERT_WINDOW_MINUTES=10
AUCTION_MAX_BID_COUNT=2
DEFAULT_DISCOUNT_THRESHOLD=0.40

# --- Resale economics (net-of-fees estimate) ------------------------------
# Estimates only, shown alongside the gross discount % on every alert — the
# headline discount doesn't know about the cost of actually reselling.
# Tune both to your real numbers; eBay's fee has category nuances and
# occasional promotions, and postage depends on the service you use.
EBAY_SELLER_FEE_RATE=0.13
RESALE_POSTAGE_GBP=3.00
# How far below the real net-breakeven cap to pitch an opening Best Offer.
OFFER_NEGOTIATION_MARGIN=0.10

# --- eBay Buy Browse API -------------------------------------------------
# "sandbox" (no approval needed, little/no real inventory) or "production"
# (needs eBay Buy API approval; flip this once it lands).
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_GB
# eBay's default application-tier limit for buy.browse search is 5000/day;
# keep this below that for headroom.
EBAY_DAILY_CALL_BUDGET=4500
EBAY_MAX_RETRIES=4
EBAY_BACKOFF_BASE_SECONDS=1.0

# --- Pokemon pricing (pokemontcg.io) -------------------------------------
# Optional but recommended once the watchlist grows: free key raises the
# limit from 1,000/day to 20,000/day. Get one at https://pokemontcg.io/
POKEMONTCG_API_KEY=
POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2

# --- Yu-Gi-Oh pricing (YGOPRODeck, no key required) -----------------------
YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7

# --- Price cache ---------------------------------------------------------
PRICE_CACHE_HOURS=12

# --- Currency conversion --------------------------------------------------
# Neither pricing API returns GBP directly. Static rates, update by hand
# periodically (see kestrel/config.py for details on why).
FX_EUR_TO_GBP_RATE=0.86
FX_USD_TO_GBP_RATE=0.79

# --- Telegram alerts (phase 2) --------------------------------------------
# Both blank -> Telegram is simply skipped; console/log output still happens.
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#    It gives you a token that looks like 123456789:AAExampleTokenHere.
# 2. Send your new bot any message (e.g. "hi") so it has something to read.
# 3. Visit https://api.telegram.org/bot<your-token>/getUpdates in a browser —
#    the JSON response has your chat id at .result[0].message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---------------------------------------------------------------
KESTREL_LOG_LEVEL=INFO
